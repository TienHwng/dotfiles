[user]
{{- if .gitName }}
	name = {{ .gitName }}
{{- end }}
{{- if .gitEmail }}
	email = {{ .gitEmail }}
{{- end }}

[init]
	defaultBranch = main

{{- /* Git LFS (wallpaper repository); replaces `git lfs install`, which would write this file directly */}}
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[fetch]
	prune = true

[rerere]
	enabled = true

[push]
	autoSetupRemote = true

[core]
	editor = nvim
{{- if eq .chezmoi.os "windows" }}
	autocrlf = false
{{- else }}
	autocrlf = input
{{- end }}

[credential]
{{- if eq .chezmoi.os "windows" }}
	helper = manager
{{- else }}
	helper = cache --timeout=7200
{{- end }}

{{- /* GitHub CLI as credential helper on every OS; replaces `gh auth setup-git`, which would
       write this file directly. With it in place `gh auth login` does not offer to. */}}
{{- $gh := lookPath "gh" }}
{{- if $gh }}
{{- /* Forward slashes for Git's sh; single quotes only when needed, as gh itself writes it */}}
{{- $gh = $gh | replace "\\" "/" }}
{{- if regexMatch "[ $]" $gh }}{{ $gh = printf "'%s'" $gh }}{{ end }}
[credential "https://github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
{{- end }}

{{- if .githubUsername }}
[github]
	user = {{ .githubUsername }}
{{- end }}
