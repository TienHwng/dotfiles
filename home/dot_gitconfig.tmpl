[user]
{{- if .gitName }}
	name = {{ .gitName }}
{{- end }}
{{- if .gitEmail }}
	email = {{ .gitEmail }}
{{- end }}

[init]
	defaultBranch = main

[fetch]
	prune = true

[rerere]
	enabled = true

[push]
	autoSetupRemote = true

[core]
	editor = nvim
{{- if eq .chezmoi.os "windows" }}
	autocrlf = false
{{- else }}
	autocrlf = input
{{- end }}

[credential]
{{- if eq .chezmoi.os "windows" }}
	helper = manager-core
{{- else }}
	helper = cache --timeout=7200
{{- end }}

{{- /* GitHub CLI as credential helper; replaces `gh auth setup-git`, which would write this file directly */}}
{{- $gh := lookPath "gh" }}
{{- if and $gh (ne .chezmoi.os "windows") }}
[credential "https://github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ $gh }} auth git-credential
{{- end }}

{{- if .githubUsername }}
[github]
	user = {{ .githubUsername }}
{{- end }}
