{{- /* Wallpapers (L6): private Git repository (plain Git, no LFS), cloned over HTTPS with the gh credential
       helper. The wallpaper step of dots fetches it; the dotfiles step excludes externals. */ -}}
{{- if .features.wallpapers }}
{{- $wallpaperDir := .wallpapers.dir }}
{{- if eq .chezmoi.os "windows" }}{{ $wallpaperDir = .wallpapers.dirWindows }}{{ end }}
[{{ $wallpaperDir | quote }}]
    type = "git-repo"
    url = {{ .wallpapers.repo | quote }}
    refreshPeriod = "168h"
    [{{ $wallpaperDir | quote }}.clone]
        args = ["--depth", "1"]
    [{{ $wallpaperDir | quote }}.pull]
        args = ["--ff-only"]
{{- end }}

{{- /* zsh plugins with no maintained package (L3), Linux only (.oh-my-zsh is ignored elsewhere).
       Public repositories; the dotfiles step fetches them as a separate target. */ -}}
{{- if eq .chezmoi.os "linux" }}
{{- range $name, $repo := dict "auto-notify" "https://github.com/MichaelAquilina/zsh-auto-notify.git" "you-should-use" "https://github.com/MichaelAquilina/zsh-you-should-use.git" "zsh-history-substring-search" "https://github.com/zsh-users/zsh-history-substring-search.git" }}
{{ $dir := printf ".oh-my-zsh/custom/plugins/%s" $name }}
[{{ $dir | quote }}]
    type = "git-repo"
    url = {{ $repo | quote }}
    refreshPeriod = "168h"
    [{{ $dir | quote }}.clone]
        args = ["--depth", "1"]
    [{{ $dir | quote }}.pull]
        args = ["--ff-only"]
{{- end }}
{{- end }}
