*.md

{{- /* Linux-only targets: shell, terminal, compositor, KDE, and the system instance config */}}
{{- if ne .chezmoi.os "linux" }}
.zshrc
.oh-my-zsh
.config/chezmoi-root
.config/environment.d
.config/fastfetch
.config/hypr
.config/kitty
.config/systemd
.config/tmux
{{- end }}

{{- /* KDE *rc files are managed per key from .chezmoidata/kde.yaml (dots desktop step);
       never add them whole, Plasma rewrites them constantly */}}
.config/kdeglobals
.config/kglobalshortcutsrc
.config/ksplashrc
.config/kwinrc
.config/plasmashellrc

{{- /* Plasma packages (splash/global themes) live in kde/ and the desktop step copies them;
       Plasma refuses package files that are symlinks out of the package */}}
.local/share/plasma

{{- /* Unix-only targets */}}
{{- if eq .chezmoi.os "windows" }}
.local/bin/dots
{{- end }}

