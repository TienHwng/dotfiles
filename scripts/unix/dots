#!/usr/bin/env bash
# dots: the single entry point for setting up and maintaining this machine.
# Every step previews what it will change and asks before running it.
set -Eeuo pipefail

# Resolve symlinks so ~/.local/bin/dots finds the repository
SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" >/dev/null 2>&1 && pwd)"
# shellcheck source=scripts/unix/lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"

ROOT_DIR="$(repo_root)"
# git-config renders ~/.gitconfig (gh credential helper) so github-login can log in to gh
# before anything clones a private repository; wallpaper needs that login.
# system-settings (sudo) goes last.
STEPS=(apps git-config github-login fonts shell-setup dotfiles desktop-settings wallpaper auto-check system-settings)
# Names used before 2026-11-03, only to point at the new name; they no longer run.
# dots sync (pull) is still a command; only the step that enabled the timer moved.
declare -A RENAMED_STEPS=(
  [packages]=apps [git]=git-config [accounts]=github-login [shell]=shell-setup
  [apply]=dotfiles [desktop]=desktop-settings [sync]=auto-check [system]=system-settings
)
DRY_RUN="${DRY_RUN:-0}"
NON_INTERACTIVE="${NON_INTERACTIVE:-0}"

usage() {
  cat <<'EOF'
Usage: dots <command> [options]

Commands:
  bootstrap [--dry-run] [--non-interactive] [--skip STEP]...
                  Set up this machine step by step: apps, git-config, github-login,
                  fonts, shell-setup, dotfiles, desktop-settings, wallpaper, auto-check,
                  system-settings. Each step says what it does to this computer, shows
                  a preview, and asks run / skip / quit before changing anything.
                  --non-interactive skips system-settings unless --dry-run is set.
  <step> [--dry-run] [--non-interactive]
                  Run one of those steps on its own, described, previewed and confirmed.
                  dots desktop-settings also repairs the Plasma packages (the Kuro splash).
  apps --diff     Report packages installed outside the manifest.
  sync [--check [--notify]]
                  Pull new commits (fast-forward only, after showing them), then run
                  the steps whose files changed, each with a preview. --check only
                  fetches and reports how far behind this machine is; --notify adds a
                  desktop notification (the auto-check timer uses it).
  status          Branch, commits behind/ahead, local changes, chezmoi drift, timer.
  capture [--dry-run] | capture kde --discover
                  Pick what changed on this machine (repository files, dotfiles
                  chezmoi copied, KDE keys, packages outside the manifest), write it
                  back, review the diff, then commit to main and push. kde --discover
                  offers KDE keys you change in System Settings while it waits.
  doctor         Check required tools, Git hooks, the manifest, and chezmoi.
  update [--packages] [--fonts] [--dry-run]
                  Upgrade installed packages (paru -Syu) and reinstall the Nerd Fonts,
                  each listed first and confirmed; neither option means both. It does
                  not pull the repository: that is dots sync.
  backup [...]    Back up the repository and the local chezmoi configs.
  cleanup [...]   Remove package-manager and chezmoi caches.
  help            Show this help.

Full guide: docs/usage.md. Prompts use gum when it is installed; set DOTS_NO_GUM=1 for plain prompts.
EOF
}

use_gum() {
  [[ -z "${DOTS_NO_GUM:-}" && -t 0 && -t 1 ]] && has gum
}

contains() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

# Prints run, skip, or quit
ask_step() {
  local step="$1" answer=''

  if use_gum; then
    answer="$(gum choose --header "Step: $step" Run Skip Quit)" || answer='Quit'
  else
    read -r -p "Run step '$step'? [Y]es / [s]kip / [q]uit: " answer || answer='q'
  fi

  case "${answer,,}" in
    '' | y | yes | run) printf 'run\n' ;;
    s | skip) printf 'skip\n' ;;
    *) printf 'quit\n' ;;
  esac
}

ask_yes() {
  if use_gum; then
    gum confirm "$1"
  else
    confirm "$1" yes
  fi
}

login_shell() {
  chezmoi_value '.shell.name' 'zsh'
}

step_title() {
  case "$1" in
    apps) printf 'Install the apps and command-line tools this setup uses' ;;
    git-config) printf 'Set your Git name and email, write ~/.gitconfig' ;;
    github-login) printf 'Log in to GitHub and check your SSH key' ;;
    fonts) printf 'Install the Nerd Fonts' ;;
    shell-setup) printf 'Make %s your login shell' "$(login_shell)" ;;
    dotfiles) printf 'Link the config files from the repository into your home folder' ;;
    desktop-settings) printf 'Change KDE Plasma settings (theme, splash, input methods)' ;;
    wallpaper) printf 'Download the wallpaper collection and set the desktop wallpaper' ;;
    auto-check) printf 'Check GitHub for repository changes in the background, notify only' ;;
    system-settings) printf 'Change system files with sudo (boot themes, GRUB, Plymouth, SDDM, pacman)' ;;
  esac
}

# What a step does to this computer, in plain words, shown before its preview:
# what changes and where, what it leaves alone, how to undo it
print_step_detail() {
  local never='' undo='' shell dir image
  local -a does=()

  case "$1" in
    apps)
      does=(
        'Installs the missing packages listed in home/.chezmoidata/packages.yaml: on CachyOS/Arch with paru (official repositories and the AUR, paru -S --needed, run as you; pacman asks for your sudo password), on Ubuntu with apt, on macOS with brew.'
        'Installs paru itself with pacman first when it is missing.'
      )
      never='remove or upgrade packages already installed (dots update upgrades, after asking).'
      undo='paru -Rns <package> (apt remove / brew uninstall elsewhere).'
      ;;
    git-config)
      does=(
        'Asks for your Git name and email if they are missing, and keeps them in ~/.config/chezmoi/chezmoi.toml on this computer only (never in the repository).'
        'Replaces ~/.gitconfig with the one built from home/dot_gitconfig.tmpl (the preview shows the difference).'
      )
      never='change the settings of any Git repository.'
      undo='edit ~/.gitconfig by hand; the next dotfiles or git-config run writes it again from the template.'
      ;;
    github-login)
      does=(
        'If the GitHub CLI is not logged in, opens your browser to log in to GitHub over HTTPS; gh keeps the token in your keyring.'
        'Checks that the Bitwarden SSH agent (~/.bitwarden-ssh-agent.sock) holds a key and that GitHub accepts it; if GitHub does not know the key yet, offers to add its public key to your GitHub account.'
        'Stops with a warning while Bitwarden is not set up: skip the step until then.'
      )
      never='store a token or a key in the repository.'
      undo='gh auth logout; remove the key at github.com/settings/keys.'
      ;;
    fonts)
      does=(
        'Downloads each Nerd Font from the manifest (its GitHub release archive) into ~/.local/share/fonts/<name>, replacing that folder, and refreshes the font cache.'
      )
      never='touch fonts installed by packages under /usr.'
      undo='rm -r ~/.local/share/fonts/<name>; fc-cache -f.'
      ;;
    shell-setup)
      shell="$(login_shell)"
      does=(
        "Makes $shell your login shell with chsh (it asks for your password); new terminals and logins start $shell."
      )
      never='edit the shell config files (the dotfiles step manages them).'
      undo='chsh -s /bin/bash (or another shell).'
      ;;
    dotfiles)
      does=(
        'Puts the config files kept in home/ (zsh, kitty, Neovim, Git, SSH, ...) into your home folder, overwriting the ones that differ; the preview shows every difference. Most become symlinks into the repository, so editing them edits the repository; templates are written as real files.'
        'Downloads the public zsh plugin repositories into ~/.oh-my-zsh/custom/plugins.'
        'Asks before overwriting a file that was edited outside dots.'
      )
      never='delete files it does not manage, touch KDE *rc files or Plasma themes (desktop-settings does), or download the wallpapers.'
      undo='there is no backup of the overwritten files: to keep a local edit, skip this step and run dots capture, which saves it into the repository instead.'
      ;;
    desktop-settings)
      does=(
        'Writes the KDE settings listed in home/.chezmoidata/kde.yaml one key at a time with kwriteconfig6, only the ones that differ; the preview shows old -> new. Running apps are told to reload.'
        'Applies the global theme with plasma-apply-lookandfeel when it differs.'
        'Copies the Plasma packages kept in kde/ (the Kuro splash) into ~/.local/share/plasma as real files, replacing a copy that is missing or differs.'
        'Sets the fcitx5 input methods (Vietnamese) and reloads fcitx5.'
        'Deletes links in ~/.config that point to files no longer in the repository.'
      )
      never='write whole *rc files, or change settings outside kde.yaml.'
      undo='change the setting back in System Settings (dots capture keeps it in the repository).'
      ;;
    wallpaper)
      dir="$(chezmoi_value '.wallpapers.dir' 'Pictures/wallpaper')"
      image="$(chezmoi_value '.wallpapers.current' 'the configured image')"
      does=(
        "Downloads the private repository TienHwng/wallpapers into ~/$dir with your GitHub login, or updates it when it is already there."
        "Sets $image from it as the Plasma wallpaper."
      )
      never="touch a folder at ~/$dir that is not that repository: it stops instead."
      undo='pick another wallpaper in Plasma; delete the folder to remove the images.'
      ;;
    auto-check)
      does=(
        'Enables the systemd user timer dots-sync.timer (its unit files come with the dotfiles step): 2 minutes after login and every 6 hours it asks GitHub for new commits and shows a notification with a Sync now button when there are some. It never downloads or changes files.'
      )
      never='pull, apply or install anything on its own.'
      undo='systemctl --user disable --now dots-sync.timer.'
      ;;
    system-settings)
      does=(
        'Uses sudo. Builds the boot theme packages in pkgbuilds/boot-themes as you (makepkg) and installs them with pacman -U.'
        'Applies root/ to / with a second chezmoi instance: GRUB (/etc/default/grub, /etc/grub.d/40_custom), Plymouth (/etc/plymouth/plymouthd.conf), SDDM (/etc/sddm.conf), pacman options (/etc/pacman.d/dots.conf, included from /etc/pacman.conf). It shows the status and diff, asks, then applies.'
        'Regenerates /boot/grub/grub.cfg and the initramfs when their inputs changed. The changes show after a reboot.'
      )
      never='write into /usr outside packages, or run without a terminal.'
      undo='restore a file from the diff, then sudo grub-mkconfig -o /boot/grub/grub.cfg and sudo mkinitcpio -P; sudo pacman -R <theme package>.'
      ;;
  esac

  printf '  What it does to this computer:\n'
  printf '    - %s\n' "${does[@]}"
  printf '  It does not %s\n' "$never"
  printf '  To undo: %s\n' "$undo"
}

# The new name of a step or command renamed on 2026-11-03; fails for other names
renamed_step() {
  [[ -n "${RENAMED_STEPS[$1]:-}" ]] && printf '%s' "${RENAMED_STEPS[$1]}"
}

step_enabled() {
  case "$1" in
    fonts) [[ "$(chezmoi_value '.features.installFonts' 'true')" == 'true' ]] ;;
    shell-setup) [[ "$(chezmoi_value '.features.setupShell' 'true')" == 'true' ]] ;;
    desktop-settings) [[ "$(chezmoi_value '.features.desktop' 'true')" == 'true' ]] ;;
    wallpaper) [[ "$(chezmoi_value '.features.wallpapers' 'true')" == 'true' ]] ;;
    *) return 0 ;;
  esac
}

# Run step $1 for real ("run") or only show what it would change ("preview").
# Previews never prompt, so setup scripts get --non-interactive there.
run_step() {
  local step="$1" mode="$2"
  local -a dry=() quiet=()

  [[ "$mode" == 'preview' || "$DRY_RUN" == '1' ]] && dry=(--dry-run)
  [[ "$mode" == 'preview' || "$NON_INTERACTIVE" == '1' ]] && quiet=(--non-interactive)

  case "$step" in
    apps) "$SCRIPT_DIR/install-packages.sh" "${dry[@]}" ;;
    git-config)
      "$SCRIPT_DIR/setup-git.sh" "${dry[@]}" "${quiet[@]}"
      apply_dotfiles "$mode" "$HOME/.gitconfig"
      ;;
    github-login) "$SCRIPT_DIR/setup-accounts.sh" "${dry[@]}" "${quiet[@]}" ;;
    fonts) "$SCRIPT_DIR/install-fonts.sh" "${dry[@]}" ;;
    shell-setup) "$SCRIPT_DIR/setup-shell.sh" "$(login_shell)" "${dry[@]}" "${quiet[@]}" ;;
    dotfiles)
      apply_dotfiles "$mode"
      # zsh plugin externals (public); the wallpaper external waits for the wallpaper step
      if [[ "$(uname -s)" == 'Linux' ]]; then
        apply_dotfiles "$mode" "$HOME/.oh-my-zsh/custom/plugins"
      fi
      ;;
    desktop-settings) "$SCRIPT_DIR/setup-desktop.sh" "${dry[@]}" ;;
    wallpaper) "$SCRIPT_DIR/setup-wallpaper.sh" "${dry[@]}" ;;
    auto-check) "$SCRIPT_DIR/setup-sync.sh" "${dry[@]}" ;;
    system-settings) "$SCRIPT_DIR/setup-system.sh" "${dry[@]}" "${quiet[@]}" ;;
  esac
}

# Apply the given targets, or everything except externals (the wallpaper step fetches those)
apply_dotfiles() {
  local mode="$1"
  shift
  local -a chezmoi_args=(--source "$ROOT_DIR/home") targets=("$@")

  [[ "$NON_INTERACTIVE" == '1' ]] && chezmoi_args+=(--no-tty)
  ((${#targets[@]})) || chezmoi_args+=(--exclude externals)

  # Previews use diff: apply --dry-run still stops to ask about files changed outside chezmoi
  if ! has chezmoi; then
    [[ "$DRY_RUN" == '1' ]] || die 'chezmoi is required before applying dotfiles.'
    print_command chezmoi "${chezmoi_args[@]}" diff --no-pager "${targets[@]}"
    log_warn 'chezmoi diff was not executed because chezmoi is unavailable.'
  elif [[ "$DRY_RUN" == '1' || "$mode" == 'preview' ]]; then
    chezmoi "${chezmoi_args[@]}" diff --no-pager "${targets[@]}"
  else
    chezmoi "${chezmoi_args[@]}" apply --verbose "${targets[@]}"
  fi
}

print_manual_checklist() {
  log_step 'Manual steps that cannot be automated:'
  printf '  %s\n' \
    'Sign in to Bitwarden and enable its SSH agent' \
    'Sign in to VS Code Settings Sync, the browser, Discord, and Steam' \
    'Enable the secret-scanning Git hook once per clone: make hooks'
}

# Runs the given steps in order: describe, preview, ask run / skip / quit. Arguments
# starting with "-" name steps to skip. Returns 1 when the person quits.
run_steps() {
  local -a skip=() steps=()
  local step choice arg

  for arg in "$@"; do
    if [[ "$arg" == -* ]]; then
      skip+=("${arg#-}")
    else
      steps+=("$arg")
    fi
  done

  for step in "${steps[@]}"; do
    log_step "[$step] $(step_title "$step")"

    if contains "$step" "${skip[@]}"; then
      log_warn "Skipping $step"
      continue
    fi
    if ! step_enabled "$step"; then
      log_warn "Skipping $step (disabled in .features)"
      continue
    fi
    if [[ "$step" == 'system-settings' && "$NON_INTERACTIVE" == '1' && "$DRY_RUN" == '0' ]]; then
      log_warn 'Skipping system-settings (sudo; it never runs non-interactively, run dots system-settings later)'
      continue
    fi
    print_step_detail "$step"
    [[ "$DRY_RUN" == '1' ]] && printf '  Dry run, nothing changes:\n'
    if [[ "$DRY_RUN" == '1' || "$NON_INTERACTIVE" == '1' ]]; then
      run_step "$step" run
      continue
    fi

    printf '  Preview, nothing has changed yet:\n'
    run_step "$step" preview || log_warn "The $step preview reported a problem; review it before running."
    choice="$(ask_step "$step")"
    case "$choice" in
      run) run_step "$step" run ;;
      skip) log_warn "Skipped $step" ;;
      quit)
        log_warn "Stopped before $step; run the same dots command again to continue."
        return 1
        ;;
    esac
  done
}

cmd_bootstrap() {
  local renamed
  local -a skip=()

  while (($#)); do
    case "$1" in
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      --non-interactive)
        NON_INTERACTIVE=1
        shift
        ;;
      --skip)
        [[ $# -ge 2 ]] || die '--skip requires a step name'
        if ! contains "$2" "${STEPS[@]}"; then
          renamed="$(renamed_step "$2")" && die "Unknown step: $2 (renamed to $renamed)"
          die "Unknown step: $2 (steps: ${STEPS[*]})"
        fi
        skip+=("$2")
        shift 2
        ;;
      -h | --help)
        usage
        return 0
        ;;
      *) die "Unknown bootstrap option: $1" ;;
    esac
  done
  export DRY_RUN NON_INTERACTIVE

  run_steps "${skip[@]/#/-}" "${STEPS[@]}" || return 0

  if [[ "$DRY_RUN" == '0' ]] && has chezmoi; then
    log_step 'Running chezmoi doctor...'
    chezmoi doctor || log_warn 'chezmoi doctor reported warnings'
  fi

  log_success 'Bootstrap complete'
  print_manual_checklist
}

# dots apps --diff reports; anything else is the apps step
cmd_apps() {
  if [[ "${1:-}" == '--diff' ]]; then
    "$SCRIPT_DIR/install-packages.sh" --diff
    return
  fi
  cmd_step apps "$@"
}

# Steps whose inputs changed, in STEPS order, for the repository paths on stdin
steps_for_paths() {
  local -A wanted=()
  local path step

  while IFS= read -r path; do
    case "$path" in
      home/.chezmoidata/packages.yaml) wanted[apps]=1 wanted[fonts]=1 ;;
      home/.chezmoidata/kde.yaml | scripts/kde-settings.tmpl) wanted["desktop-settings"]=1 ;;
      home/.chezmoidata/windows.yaml) ;;
      home/.chezmoiexternal.toml.tmpl | home/.chezmoidata.yaml) wanted[dotfiles]=1 wanted[wallpaper]=1 ;;
      home/*) wanted[dotfiles]=1 ;;
      root/* | pkgbuilds/*) wanted["system-settings"]=1 ;;
    esac
  done

  for step in "${STEPS[@]}"; do
    [[ -n "${wanted[$step]:-}" ]] && printf '%s\n' "$step"
  done
  return 0
}

# Pull (fast-forward only, after showing the commits), then run the steps whose files changed
cmd_sync() {
  local before after
  local -a steps

  case "${1:-}" in
    --check)
      shift
      "$SCRIPT_DIR/sync.sh" --check "$@"
      return
      ;;
    '') ;;
    *) die "Unknown sync option: $1" ;;
  esac
  [[ "$NON_INTERACTIVE" == '1' ]] && die 'dots sync asks before pulling; use dots sync --check without a terminal.'

  # Linux symlinks dotfiles into the repository, so local edits show up here
  if [[ -n "$(git -C "$ROOT_DIR" status --porcelain --untracked-files=no)" ]]; then
    git -C "$ROOT_DIR" status --short --untracked-files=no
    die 'The repository has local changes; commit them (dots capture) before syncing.'
  fi

  "$SCRIPT_DIR/sync.sh" --check
  before="$(git -C "$ROOT_DIR" rev-parse HEAD)"
  if [[ "$(git -C "$ROOT_DIR" rev-list --count 'HEAD..@{upstream}')" == '0' ]]; then
    log_success 'Already up to date'
    return 0
  fi

  git -C "$ROOT_DIR" log --oneline --no-decorate 'HEAD..@{upstream}'
  git -C "$ROOT_DIR" diff --stat 'HEAD...@{upstream}'
  if ! ask_yes 'Pull these commits?'; then
    log_warn 'Nothing pulled'
    return 0
  fi
  git -C "$ROOT_DIR" merge --ff-only --quiet '@{upstream}' \
    || die 'Cannot fast-forward (local commits?); rebase or merge by hand.'
  after="$(git -C "$ROOT_DIR" rev-parse HEAD)"
  log_success "Pulled ${before:0:7}..${after:0:7}"

  mapfile -t steps < <(git -C "$ROOT_DIR" diff --name-only "$before" "$after" | steps_for_paths)
  if ((${#steps[@]} == 0)); then
    log_success 'No step needs to run for these changes'
    return 0
  fi
  log_step "Steps for the changed files: ${steps[*]}"
  run_steps "${steps[@]}" || return 0
  log_success 'Sync complete'
}

cmd_status() {
  local branch upstream counts timer drift local_changes

  branch="$(git -C "$ROOT_DIR" branch --show-current)"
  printf 'Repository   %s (%s)\n' "$ROOT_DIR" "${branch:-detached}"
  if upstream="$(git -C "$ROOT_DIR" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null)"; then
    GIT_TERMINAL_PROMPT=0 timeout 20 git -C "$ROOT_DIR" fetch --quiet 2>/dev/null \
      || log_warn 'git fetch failed; counts use the last fetch'
    counts="$(git -C "$ROOT_DIR" rev-list --left-right --count 'HEAD...@{upstream}')"
    printf 'Upstream     %s: %s behind, %s ahead\n' "$upstream" "${counts##*[[:space:]]}" "${counts%%[[:space:]]*}"
  else
    printf 'Upstream     none\n'
  fi

  local_changes="$(git -C "$ROOT_DIR" status --porcelain | wc -l)"
  printf 'Local edits  %s file(s) changed in the repository (dots capture)\n' "$local_changes"

  if has chezmoi; then
    drift="$(chezmoi --source "$ROOT_DIR/home" status --exclude externals 2>/dev/null | wc -l || true)"
    printf 'Drift        %s target(s) differ from home/ (chezmoi status)\n' "$drift"
  fi

  if has systemctl && systemctl --user show-environment >/dev/null 2>&1; then
    timer="$(systemctl --user is-enabled dots-sync.timer 2>/dev/null || true)"
    [[ "$timer" == 'not-found' || -z "$timer" ]] && timer='not installed (run: dots auto-check)'
    printf 'Sync timer   %s\n' "$timer"
  fi
}

# dots <step> [--dry-run]: one bootstrap step on its own, previewed and confirmed
cmd_step() {
  local step="$1"
  shift
  while (($#)); do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      --non-interactive) NON_INTERACTIVE=1 ;;
      *) die "Unknown $step option: $1" ;;
    esac
    shift
  done
  export DRY_RUN NON_INTERACTIVE
  run_steps "$step" || true
}

cmd_system() {
  log_step "[system-settings] $(step_title system-settings)"
  print_step_detail system-settings
  case "${1:-}" in
    --dry-run)
      printf '  Dry run, nothing changes:\n'
      "$SCRIPT_DIR/setup-system.sh" --dry-run
      ;;
    '')
      [[ "$NON_INTERACTIVE" == '1' ]] \
        && die 'dots system-settings changes / and never runs non-interactively; use --dry-run to preview.'
      printf '  Preview, nothing has changed yet:\n'
      "$SCRIPT_DIR/setup-system.sh" --dry-run
      if ask_yes 'Run system-settings with sudo?'; then
        "$SCRIPT_DIR/setup-system.sh"
      else
        log_warn 'Nothing changed'
      fi
      ;;
    *) die "Unknown system-settings option: $1" ;;
  esac
}

# Plasma packages from kde.packages: installed, real files, same as kde/. Plasma refuses
# package files that are symlinks out of the package, which once made the splash vanish.
doctor_plasma_packages() {
  local path id target splash refused since=0 stamp
  if ! has kreadconfig6 || ! has chezmoi; then
    log_warn 'KDE Plasma 6 or chezmoi is missing; Plasma packages not checked'
    return 0
  fi
  while IFS=$'\t' read -r path id; do
    [[ -n "$path" ]] || continue
    target="${XDG_DATA_HOME:-$HOME/.local/share}/$path/$id"
    if [[ ! -d "$target" ]]; then
      log_warn "$id is not installed; run: dots desktop-settings"
    elif [[ -L "$target" || -n "$(find "$target" -type l -print -quit)" ]]; then
      log_warn "$id contains symlinks, which Plasma refuses; run: dots desktop-settings"
    elif ! diff -rq "$ROOT_DIR/kde/$path/$id" "$target" >/dev/null 2>&1; then
      log_warn "$id differs from kde/$path/$id; keep it with dots capture, or restore it with dots desktop-settings"
    else
      log_success "$id is installed as real files and matches the repository"
    fi
    stamp="$(stat -c %Y "$target" 2>/dev/null || printf 0)"
    ((stamp > since)) && since="$stamp"
  done < <(chezmoi --source "$ROOT_DIR/home" execute-template \
    '{{ range .kde.packages }}{{ .path }}{{ "\t" }}{{ .id }}{{ "\n" }}{{ end }}')

  splash="$(kreadconfig6 --file ksplashrc --group KSplash --key Theme)"
  if [[ -n "$splash" && "$splash" != 'None' ]] \
    && [[ ! -d "${XDG_DATA_HOME:-$HOME/.local/share}/plasma/look-and-feel/$splash" ]] \
    && [[ ! -d "/usr/share/plasma/look-and-feel/$splash" ]]; then
    log_warn "The splash screen $splash is not installed anywhere; run: dots desktop-settings"
  fi
  if has journalctl; then
    # Only refusals after the packages were last installed count
    refused="$(journalctl --user -b -o cat --since "@$since" 2>/dev/null \
      | grep -a -c 'Path traversal attempt detected' || true)"
    if ((refused > 0)); then
      log_warn "Plasma refused $refused package file(s) (journalctl --user -b | grep 'Path traversal'); run: dots desktop-settings"
    fi
  fi
}

cmd_doctor() {
  local failures=0 platform count hooks_path tool

  log_step 'Required tools'
  for tool in git chezmoi; do
    if has "$tool"; then
      log_success "$tool: $(command -v "$tool")"
    else
      log_error "$tool is missing"
      failures=$((failures + 1))
    fi
  done

  log_step 'Optional tools'
  for tool in gum gitleaks fzf bw; do
    if has "$tool"; then
      log_success "$tool: $(command -v "$tool")"
    else
      log_warn "$tool is missing (install it from the manifest)"
    fi
  done

  log_step 'Package manifest'
  platform="$(detect_platform)"
  if [[ "$platform" != 'unknown' ]] && has chezmoi; then
    if count="$(manifest_list "$platform" | grep -c .)"; then
      log_success "$count package(s) listed for $platform"
    else
      log_error "The $platform list in the package manifest is empty or unreadable"
      failures=$((failures + 1))
    fi
  else
    log_warn "No package list for platform: $platform"
  fi

  log_step 'SSH agent'
  if [[ "$(chezmoi_value '.accounts.ssh.agent' 'bitwarden')" != 'bitwarden' ]]; then
    log_success 'SSH keys are files on disk (.accounts.ssh.agent = file)'
  elif SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock" ssh-add -l >/dev/null 2>&1; then
    log_success 'Bitwarden SSH agent is running and holds keys'
  else
    log_warn 'Bitwarden SSH agent is not running or holds no keys; see: dots github-login'
  fi

  log_step 'Plasma packages'
  doctor_plasma_packages

  log_step 'Sync timer'
  if has systemctl && systemctl --user show-environment >/dev/null 2>&1; then
    if [[ "$(systemctl --user is-enabled dots-sync.timer 2>/dev/null || true)" == 'enabled' ]]; then
      log_success 'dots-sync.timer is enabled (repository check at login and every 6 hours)'
    else
      log_warn 'dots-sync.timer is not enabled; run: dots auto-check'
    fi
  else
    log_warn 'No systemd user manager; the repository check timer cannot run here'
  fi

  log_step 'Git hooks'
  hooks_path="$(git -C "$ROOT_DIR" config --get core.hooksPath || true)"
  if [[ "$hooks_path" == '.githooks' ]]; then
    log_success 'Secret-scanning pre-commit hook is enabled'
  else
    log_warn 'Git hooks are off for this clone; run: make hooks'
  fi

  if [[ "$(uname -s)" == 'Linux' ]]; then
    log_step 'System instance'
    if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi-root/chezmoi.toml" ]]; then
      log_success 'System instance config found'
    else
      log_warn 'System instance config missing; run chezmoi apply to render it'
    fi
  fi

  if has chezmoi; then
    log_step 'chezmoi doctor'
    # Its errors include environment quirks (e.g. no hardlinks into a tmpfs /tmp)
    chezmoi doctor || log_warn 'chezmoi doctor reported problems; review its output above'
  fi

  if ((failures)); then
    log_error "$failures check(s) failed"
    return 1
  fi
  log_success 'All required checks passed'
}

main() {
  local command="${1:-help}"
  (($#)) && shift

  case "$command" in
    bootstrap) cmd_bootstrap "$@" ;;
    apps) cmd_apps "$@" ;;
    system-settings) cmd_system "$@" ;;
    sync) cmd_sync "$@" ;;
    status) cmd_status ;;
    capture) "$SCRIPT_DIR/capture.sh" "$@" ;;
    doctor) cmd_doctor ;;
    update) "$SCRIPT_DIR/update.sh" "$@" ;;
    backup) "$SCRIPT_DIR/backup.sh" "$@" ;;
    cleanup) "$SCRIPT_DIR/cleanup.sh" "$@" ;;
    help | -h | --help) usage ;;
    *)
      if contains "$command" "${STEPS[@]}"; then
        cmd_step "$command" "$@"
        return
      fi
      local renamed
      renamed="$(renamed_step "$command")" && die "Unknown command: $command (renamed to $renamed: dots $renamed)"
      usage >&2
      die "Unknown command: $command"
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
